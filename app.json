{
  "expo": {
    "name": "Chakrava",
    "slug": "chakrava",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "chakrava",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chakrava.app"
    },

    "android": {
      "package": "com.chakrava.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },

    "web": {
      "bundler": "metro"
    },

    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Chakrava needs your location to track waste collection vehicles in real time."
        }
      ]
    ],

    "extra": {
      "supabaseUrl": "https://qkirblzamykhelibxpnd.supabase.co",
      "supabaseAnonKey": "sb_publishable_vTmUc8ibHITBQQNprckzgA_UnasoboE",
      "eas": {
        "projectId": "c4c64836-a7dc-4f17-8248-344f4b260b6e"
      }
    },

    "owner": "hudaa_anjumm"
  }
}